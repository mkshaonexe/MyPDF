<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/page_margin_horizontal"
    android:paddingEnd="@dimen/page_margin_horizontal"
    android:paddingTop="@dimen/page_margin_vertical"
    android:paddingBottom="@dimen/page_margin_vertical"
    android:clipToPadding="false">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        app:cardBackgroundColor="@color/pdf_page_background"
        app:cardCornerRadius="@dimen/page_card_corner_radius"
        app:cardElevation="@dimen/page_card_elevation"
        app:strokeWidth="1dp"
        app:strokeColor="@color/pdf_page_border">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />

    </com.google.android.material.card.MaterialCardView>
</FrameLayout>